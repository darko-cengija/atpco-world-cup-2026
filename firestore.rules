rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function drawListsOpen() {
      return get(/databases/$(database)/documents/config/app).data.drawStatus == 'list_building';
    }

    function drawTeamCount() {
      return get(/databases/$(database)/documents/config/app).data.drawTeamCount;
    }

    function validDrawTeamCount() {
      return drawTeamCount() is int
        && drawTeamCount() > 0
        && drawTeamCount() <= 128;
    }

    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarUrl', 'onboardingComplete'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && (
          request.resource.data.avatarUrl == null
          || (
            request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.size() <= 500
          )
        )
        && request.resource.data.onboardingComplete is bool;
    }

    function validPrediction() {
      return request.resource.data.keys().hasOnly(['matchId', 'userId', 'outcome', 'submittedAt'])
        && request.resource.data.matchId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.outcome in ['1', 'X', 'X1', 'X2', '2']
        && request.resource.data.submittedAt == request.time
        && request.time < get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.date
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'upcoming';
    }

    function validTeamList(userId) {
      return request.resource.data.keys()
          .hasOnly(['userId', 'teamIds', 'teamCount', 'rankingSnapshot', 'updatedAt', 'createdAt'])
        && request.resource.data.userId == userId
        && request.resource.data.teamIds is list
        && validDrawTeamCount()
        && request.resource.data.teamIds.size() == drawTeamCount()
        && request.resource.data.teamCount == drawTeamCount()
        && request.resource.data.updatedAt == request.time;
    }

    function validTeamListStatus(userId) {
      return request.resource.data.keys().hasOnly(['userId', 'ready', 'teamCount', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.ready is bool
        && validDrawTeamCount()
        && request.resource.data.teamCount == drawTeamCount()
        && request.resource.data.updatedAt == request.time;
    }

    function validMessageCreate() {
      return request.resource.data.keys()
          .hasOnly(['text', 'authorId', 'authorName', 'authorAvatar', 'timestamp', 'replyTo', 'mentions'])
        && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'timestamp', 'mentions'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (
          request.resource.data.get('authorAvatar', null) == null
          || (
            request.resource.data.authorAvatar is string
            && request.resource.data.authorAvatar.size() <= 500
          )
        )
        && request.resource.data.timestamp == request.time
        && request.resource.data.mentions is list
        && request.resource.data.mentions.size() <= 20
        && (
          request.resource.data.get('replyTo', null) == null
          || request.resource.data.replyTo is map
        );
    }

    function validInvite() {
      return request.resource.data.keys().hasOnly(['email', 'name'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
    }

    function validPlayerTeam() {
      return request.resource.data.keys().hasOnly(['userId', 'teamId', 'round', 'pick', 'assignedAt'])
        && request.resource.data.userId is string
        && request.resource.data.teamId is string;
    }

    // Predictions: members can write only their own still-open match picks.
    // Cloud Functions (Admin SDK) bypass these rules.
    match /predictions/{predId} {
      allow read: if isMember();
      allow create, update: if isMember() && validPrediction();
      allow delete: if isAdmin();
    }

    // Matches + teams: client reads only. Writes go through Cloud Functions.
    match /matches/{matchId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /teams/{teamId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /stats/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Private player ranking lists. Even admins do not get client-side read access.
    match /teamLists/{userId} {
      allow read: if isMember() && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && drawListsOpen()
        && validTeamList(userId);
      allow delete: if false;
    }

    // Public readiness only; does not expose the private order.
    match /teamListStatuses/{userId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.auth.uid == userId
        && drawListsOpen()
        && validTeamListStatus(userId);
      allow delete: if false;
    }

    // Public live draw state. Mutations go through callable Cloud Functions.
    match /draw/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // User's own chat read-marker doc.
    match /chatReads/{userId} {
      allow read: if isMember() && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt == request.time;
      allow delete: if false;
    }

    // User's own push-notification tokens.
    match /pushTokens/{userId} {
      allow read: if isMember() && request.auth.uid == userId;
      allow create, update: if isMember() && request.auth.uid == userId;
      allow delete: if isMember() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isMember();
      allow create: if false;
      allow update: if isMember()
        && request.auth.uid == userId
        && validProfileUpdate();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /messages/{msgId} {
      allow read: if isMember();
      allow create: if isMember() && validMessageCreate();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      allow delete: if isAdmin();
    }

    match /allowedUsers/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validInvite();
      allow delete: if isAdmin();
    }

    match /inviteLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /playerTeams/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && validPlayerTeam();
      allow delete: if isAdmin();
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /teamReplacementHistory/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
